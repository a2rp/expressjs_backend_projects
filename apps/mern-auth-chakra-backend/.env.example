NODE_ENV=development
PORT=1198
MONGODB_URI=mongodb://127.0.0.1:27017/mern_auth_chakra
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRES=2h
FRONTEND_URL=http://localhost:5173
